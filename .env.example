# ---------------- Application ----------------
APP_NAME=SANAA AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TIMEZONE=Africa/Cairo
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------------- Security ----------------
# Header X-API-Key for /api/internal/* (leave empty only in development)
INTERNAL_API_KEY=
# Secret used to sign customer tokens - generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=120

# ---------------- PostgreSQL (read-only AI user) ----------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=furniture_erp
DB_USER=ai_readonly
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------- PostgreSQL (app user that writes to schema sanaa_ai) ----------------
# Leave DB_APP_PASSWORD empty to keep chatbot sessions/quotations in memory only.
DB_APP_USER=ai_app
DB_APP_PASSWORD=

# ---------------- Ollama (local LLM) ----------------
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b fits an 8 GB GPU (RTX 3060 Ti). Alternative: qwen3:8b (keep OLLAMA_THINK=false)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_THINK=false
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=900
OLLAMA_KEEP_ALIVE=30m

# ---------------- Analysis ----------------
MAX_SQL_ROWS=100
MAX_QUESTION_LENGTH=2000
MAX_SQL_ATTEMPTS=3
RAG_USE_EMBEDDINGS=false

# ---------------- Voice ----------------
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
TTS_VOICE_AR=ar-EG-SalmaNeural
TTS_VOICE_EN=en-US-AriaNeural

# ---------------- Recommendations (Phase 2) ----------------
MONTHLY_REPORT_ENABLED=true
MONTHLY_REPORT_DAY=1
MONTHLY_REPORT_HOUR=7
FORECAST_HORIZON_MONTHS=3

# ---------------- Customer services (Phases 3-5) ----------------
DEFAULT_DELIVERY_CITY=Cairo
QUOTATION_VALID_DAYS=14
DESIGN_OUTPUT_DIR=generated_designs
PUBLIC_BASE_URL=http://localhost:8000
