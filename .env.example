# ============================================================
#  صنعة SANAA — local settings
#  Copy this file to ".env.local" and fill in the values.
#  (".env" already holds the public address of the online database.)
# ============================================================

# ---- Database (backend) ----
# Option A — use the online Lovable Cloud database: keep the values in .env as they are.
# Option B — fully local database (Docker + Supabase CLI): after `npx supabase start`
#            paste the "API URL", "anon key / publishable key" and "service_role / secret key" here:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=
# Needed for customer chat, order tracking and AI analysis (only available with Option B):
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Customer login tokens (/api/customer/*) ----
# Any long random text, e.g. run:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-text
JWT_EXPIRE_MINUTES=120

# ---- Management API key (/api/internal/* with header X-API-Key) ----
INTERNAL_API_KEY=change-me-too

# ---- AI (pick ONE) ----
# 1) Free & offline, like the original SANAA model: Ollama  (https://ollama.com)
#      ollama pull qwen2.5:7b
AI_BASE_URL=http://localhost:11434/v1
AI_CHAT_MODEL=qwen2.5:7b
#
# 2) OpenAI (paid key from platform.openai.com) — also enables voice:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_CHAT_MODEL=gpt-4o-mini
# AI_TRANSCRIBE_MODEL=whisper-1
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=alloy
#
# 3) Lovable AI (same as the online site): remove AI_BASE_URL and set
# LOVABLE_API_KEY=
